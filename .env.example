# Copy this file to ".env" (same folder) and fill in YOUR values. Never upload .env to GitHub.
# On Render, put the same names in the service's Environment tab instead.

# --- KHQR payment ---
BAKONG_ACCOUNT_ID=your_name@your_bank      # your own Bakong account ID (the one that receives the money)
MERCHANT_NAME=Mekong Shop                  # name shown in the customer's banking app (max 25 characters)
MERCHANT_CITY=Phnom Penh
# KHQR_PHONE=855xxxxxxxxx                  # optional
KHQR_CURRENCY=USD                          # USD or KHR
# KHR_RATE=4100                            # only used when KHQR_CURRENCY=KHR
# BAKONG_TOKEN=paste_your_bakong_api_token_here   # enables automatic payment checking (see README)
# KHQR_VERIFY=off                          # set to "off" to skip the automatic check (shop confirms manually)

# --- Shop ---
SHOP_NAME=Mekong Shop
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
